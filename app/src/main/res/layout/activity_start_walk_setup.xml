<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:padding="24dp"
    tools:context=".walk.StartWalkSetupActivity">

    <TextView
        android:id="@+id/setupTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Where are you going?"
        android:textColor="@color/text_on_dark"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/destinationInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@color/surface_dark"
        android:hint="Search destination"
        android:padding="14dp"
        android:textColor="@color/text_on_dark"
        android:textColorHint="@color/text_on_dark_secondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/setupTitle" />

    <LinearLayout
        android:id="@+id/suggestionList"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/surface_dark_elevated"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/destinationInput" />

    <LinearLayout
        android:id="@+id/chipRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/suggestionList">

        <TextView
            android:id="@+id/chipHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@color/surface_dark_elevated"
            android:gravity="center"
            android:padding="12dp"
            android:text="Home"
            android:textColor="@color/text_on_dark" />

        <TextView
            android:id="@+id/chipLibrary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@color/surface_dark_elevated"
            android:gravity="center"
            android:padding="12dp"
            android:text="Library"
            android:textColor="@color/text_on_dark" />

        <TextView
            android:id="@+id/chipHostel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@color/surface_dark_elevated"
            android:gravity="center"
            android:padding="12dp"
            android:text="Hostel"
            android:textColor="@color/text_on_dark" />
    </LinearLayout>

    <TextView
        android:id="@+id/etaText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="SafeWalk will track your live location and recompute your risk every few seconds once you start."
        android:textColor="@color/text_on_dark_secondary"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chipRow" />

    <Button
        android:id="@+id/startWalkButton"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginBottom="24dp"
        android:backgroundTint="@color/pink"
        android:text="Start Walk"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
