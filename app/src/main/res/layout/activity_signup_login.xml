<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true"
    tools:context=".onboarding.SignUpLoginActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:id="@+id/welcomeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="Welcome to SafeWalk"
            android:textColor="@color/text_on_dark"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/authSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Sign in to back up your walks and share them live."
            android:textColor="@color/text_on_dark_secondary" />

        <EditText
            android:id="@+id/emailInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:autofillHints="emailAddress"
            android:background="@color/surface_dark"
            android:hint="Email"
            android:inputType="textEmailAddress"
            android:padding="14dp"
            android:textColor="@color/text_on_dark"
            android:textColorHint="@color/text_on_dark_secondary" />

        <EditText
            android:id="@+id/passwordInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:autofillHints="password"
            android:background="@color/surface_dark"
            android:hint="Password (min 6 characters)"
            android:inputType="textPassword"
            android:padding="14dp"
            android:textColor="@color/text_on_dark"
            android:textColorHint="@color/text_on_dark_secondary" />

        <Button
            android:id="@+id/signInButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/accent_purple"
            android:text="Sign in"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/createAccountButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/pink"
            android:text="Create account"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/authStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="@color/text_on_dark_secondary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/offlineButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:background="@color/surface_dark"
            android:text="Continue without an account"
            android:textColor="@color/text_on_dark" />

        <TextView
            android:id="@+id/termsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="By continuing, you agree to our Terms &amp; Privacy Policy."
            android:textColor="@color/text_on_dark_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
